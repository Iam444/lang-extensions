{
  "name": "lang-extensions",
  "description": "A bunch of helpful abstractions over native JS/TS capabilities",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./entity": {
      "types": "./dist/entity/index.d.ts",
      "import": "./dist/entity/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "import": "./dist/helpers/index.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "import": "./dist/identity/index.js"
    },
    "./list": {
      "types": "./dist/list/index.d.ts",
      "import": "./dist/list/index.js"
    },
    "./result": {
      "types": "./dist/result/index.d.ts",
      "import": "./dist/result/index.js"
    },
    "./uuid": {
      "types": "./dist/uuid/index.d.ts",
      "import": "./dist/uuid/index.js"
    },
    "./value-object": {
      "types": "./dist/value-object/index.d.ts",
      "import": "./dist/value-object/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "build": "tsc --build"
  },
  "author": {
    "name": "Pavel Kolesnikov",
    "email": "iam444@mail.ru"
  },
  "license": "ISC",
  "dependencies": {
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.57.0"
  }
}
